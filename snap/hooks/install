#!/bin/bash
set -e

ONNX="$SNAP/models/depth_anything_v2_small.onnx"
ENGINE="$SNAP_COMMON/models/depth_anything_v2_small.engine"
LOG="$SNAP_COMMON/models/conversion.log"
TRTEXEC="/usr/src/tensorrt/bin/trtexec"

mkdir -p "$SNAP_COMMON/models"

if [ -f "$ENGINE" ]; then
    echo "TRT engine already built at $ENGINE — skipping."
    exit 0
fi

if [ ! -f "$TRTEXEC" ]; then
    echo "WARNING: trtexec not found at $TRTEXEC"
    echo "Ensure JetPack is installed and system-files-tegra plug is connected."
    echo "Skipping engine build — depth inference will not work until engine exists."
    echo "To build manually after connecting the plug:"
    echo "  $TRTEXEC --onnx=$ONNX --saveEngine=$ENGINE --fp16 \\"
    echo "    --minShapes=pixel_values:1x3x518x518 \\"
    echo "    --optShapes=pixel_values:1x3x518x518 \\"
    echo "    --maxShapes=pixel_values:1x3x518x518"
    exit 0
fi

echo "Building TensorRT engine (first run — this takes ~10 minutes)..."
echo "Progress log: $LOG"

"$TRTEXEC" \
    --onnx="$ONNX" \
    --saveEngine="$ENGINE" \
    --fp16 \
    --minShapes=pixel_values:1x3x518x518 \
    --optShapes=pixel_values:1x3x518x518 \
    --maxShapes=pixel_values:1x3x518x518 \
    2>&1 | tee "$LOG"

echo "Engine build complete: $ENGINE"
